skill manuscript_period_explosion {
    cooldown = 10s
    group = "major"
    concurrency = "reject"
    requires condition.isLiving(target)
    let center = target.position
    repeat 36 {
        mechanic.particles.circle(center, SOUL_FIRE_FLAME, 3.5, 48)
        wait 1t
    }
    for player in targeter.players.within(center, 4) {
        mechanic.damage(player, 14)
        mechanic.entity.push(player, center, 0.75)
    }
}
