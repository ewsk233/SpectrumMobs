skill manuscript_final_chapter {
    cooldown = 40s
    group = "ultimate"
    concurrency = "reject"
    requires phase == "finale"
    let existing = targeter.summons(caster, tag = "spectrum_manuscript_core")
    if (existing.isEmpty) {
        let batch = mechanic.mob.summon(id = "spectrum:manuscript_core", at = caster.position, count = 3, tag = "spectrum_manuscript_core", ignoreRejected = true, lifetime = 6s)
        if (batch.success) {
            for player in targeter.players.within(caster.position, 40) {
                mechanic.title.show(player, "&4终章", "&c摧毁句核碎片，否则文字风暴将降临", 5t, 100t, 10t)
            }
            repeat 100 {
                mechanic.particles.circle(caster.position, ENCHANT, 6, 48)
                wait 1t
            }
            if (condition.summons.defeated(caster, batch)) {
                mechanic.entity.temporaryTag(caster, "spectrum_manuscript_vulnerable", 5s)
                for player in targeter.players.within(caster.position, 40) {
                    mechanic.message.send(player, "&a缄言的核心暴露了！")
                }
            } else {
                mechanic.mob.cleanup(caster, batch)
                for player in targeter.players.within(caster.position, 40) {
                    mechanic.damage(player, 28)
                    mechanic.entity.push(player, caster.position, 1.0)
                }
            }
        } else {
            mechanic.mob.cleanup(caster, batch)
        }
    }
}
